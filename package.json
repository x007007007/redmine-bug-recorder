{
  "name": "redmine-bug-recorder",
  "version": "0.2.7",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "description": "测试助手浏览器插件(Chrome MV3 / Firefox MV3):录制 UI 操作(每步截图)+ API 交互 + Vue/React 组件与 Pinia 状态,勾选 review 后一键提交 Redmine",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit",
    "test": "tsc -p tests --noEmit && node tools/run-unit.mjs",
    "complexity": "node tools/complexity.mjs",
    "dev:chrome": "node tools/dev-launch.mjs chrome",
    "dev:firefox": "node tools/dev-launch.mjs firefox",
    "dev:both": "node tools/dev-launch.mjs both",
    "build": "npm run typecheck && node build.mjs",
    "build:fast": "node build.mjs",
    "watch": "node build.mjs --watch",
    "release": "npm run typecheck && node build.mjs && node tools/make-release.mjs",
    "source-zip": "node tools/make-source-package.mjs",
    "version:set": "node tools/set-version.mjs",
    "smoke": "node tools/cdp_smoke.mjs 9223 bkeogdmbgodhopooimgmbacldmdmpeap \"$PWD\""
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "typhonjs-escomplex": "^0.1.0",
    "web-ext": "^10.8.0"
  }
}
