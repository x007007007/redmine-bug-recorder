{
  "name": "redmine-bug-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "测试助手浏览器插件(Chrome MV3 / Firefox MV3):录制 UI 操作(每步截图)+ API 交互 + Vue/Pinia 状态,勾选 review 后一键提交 Redmine",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "build:fast": "node build.mjs",
    "watch": "node build.mjs --watch",
    "release": "npm run typecheck && node tools/make-release.mjs",
    "source-zip": "node tools/make-source-package.mjs",
    "smoke": "node tools/cdp_smoke.mjs 9223 bkeogdmbgodhopooimgmbacldmdmpeap \"$PWD\""
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "typescript": "5.9"
  }
}
